# Database
# Use SQLite for local development:
DATABASE_URL=sqlite:///./mdm.db
# Or PostgreSQL for production:
# DATABASE_URL=postgresql://mdm_user:mdm_password@localhost:5432/mdm_db

# Security & JWT
JWT_SECRET=super-secret-jwt-key-replace-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Admin@123456

# CORS
CORS_ORIGINS=http://localhost:5200,http://127.0.0.1:5200
